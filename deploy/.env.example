# Copy to /opt/blog/.env (mode 600) and fill in. Names only; values never enter the repository.

# The database's password, set once when its volume is first created.
BLOG_DB_PASSWORD=

# The origin readers see, https://<domain>; GitHub's callback is <BLOG_PUBLIC_URL>/api/auth/github/callback.
BLOG_PUBLIC_URL=

# The GitHub OAuth App for the admin's sign-in. Left empty, sign-in is off.
BLOG_GITHUB_CLIENT_ID=
BLOG_GITHUB_CLIENT_SECRET=

# The Cloudflare Tunnel's token.
TUNNEL_TOKEN=

# Optional.
# BLOG_ADMIN_GITHUB_LOGIN=     default seeeeeeong
# BLOG_TAG=                    an image tag to run instead of main, such as a commit SHA to roll back to
