# Copy to .env at the repository root. Never commit .env.
# KEY=VALUE per line, UTF-8, each value as written: no quotes, no escapes, spaces kept.
# The local database needs nothing here: application.yml defaults to compose.yaml's.
# A deployment sets BLOG_DB_URL, BLOG_DB_USER and BLOG_DB_PASSWORD.
#
# The web does not read this file; it takes its settings from the environment it is built in.
# NEXT_PUBLIC_SITE_URL is the public origin the RSS feed links to (default http://localhost:3150).

# Admin sign-in through a GitHub OAuth App, whose callback URL is
# <BLOG_PUBLIC_URL>/api/auth/github/callback. Left empty, sign-in is off and the blog still serves readers.
BLOG_GITHUB_CLIENT_ID=
BLOG_GITHUB_CLIENT_SECRET=

# YES24 Open API key for importing a book and its contents. Left empty, book import is off.
BLOG_YES24_API_KEY=

# DeepSeek API key for study notes, drafts from a memo and readers' Ask. Left empty, all are off.
BLOG_DEEPSEEK_API_KEY=

# A random secret that readers' addresses are hashed with to count their daily questions, such as
# `openssl rand -hex 32`. Left empty, one is made at start and a restart starts the day's counts over.
BLOG_ASK_IP_SALT=

# Locally the defaults hold; a deployment sets these. A key set to nothing here is empty, not its default.
# BLOG_PUBLIC_URL=https://example.com        the origin the browser sees; default http://localhost:3150
# BLOG_ADMIN_GITHUB_LOGIN=seeeeeeong          the one GitHub login that may sign in
# BLOG_COOKIE_SECURE=true                     the local profile turns it off for plain http
