{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": ["**", "!**/node_modules", "!**/.next", "!**/*.d.ts", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 12
          }
        },
        "noImportantStyles": "off"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useImportType": "error",
        "noEnum": "error",
        "noDescendingSpecificity": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**", "./**/../**"],
                "message": "Import from another folder through @/."
              }
            ]
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/**", "src/hooks/**", "src/lib/**", "src/utils/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "@/app/**", "../**", "./**/../**"],
                    "message": "Shared code imports neither a feature nor a route."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "@/app/**", "../**", "./**/../**"],
                    "message": "A feature imports only itself and shared code; give each feature an override after this one that allows itself."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/admin/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/admin/**",
                      "@/app/**",
                      "../**",
                      "./**/../**"
                    ],
                    "message": "A feature imports only itself and shared code; compose features in a route."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/ask/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/ask/**",
                      "@/app/**",
                      "../**",
                      "./**/../**"
                    ],
                    "message": "A feature imports only itself and shared code; compose features in a route."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/books/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/books/**",
                      "@/app/**",
                      "../**",
                      "./**/../**"
                    ],
                    "message": "A feature imports only itself and shared code; compose features in a route."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/cmd/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/cmd/**",
                      "@/app/**",
                      "../**",
                      "./**/../**"
                    ],
                    "message": "A feature imports only itself and shared code; compose features in a route."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/posts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/posts/**",
                      "@/app/**",
                      "../**",
                      "./**/../**"
                    ],
                    "message": "A feature imports only itself and shared code; compose features in a route."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/widgets/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/widgets/**",
                      "@/app/**",
                      "../**",
                      "./**/../**"
                    ],
                    "message": "A feature imports only itself and shared code; compose features in a route."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
